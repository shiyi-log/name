  "reviews": [
    {
      "name": "溪山有蹊",
      "decision": "keep",
      "reason": "溪山与山间小径构成清楚自然的山水意象，“有蹊”带有路径可寻之意，组合凝练且有辨识度。"
    },
    {
      "name": "松风入蹊",
      "decision": "keep",
      "reason": "松风入小径，语序自然，形成清雅而具体的景象；与“凉风入松”等候选意象和关系不同，不构成近似重复。"
    },
    {
      "name": "花影覆蹊",
      "decision": "keep",
      "reason": "花影覆盖小径，语义连贯，画面明确，具有凝练的品牌意象。"
    },
    {
      "name": "石径通蹊",
      "decision": "reject",
      "reason": "“石径”与“蹊”都指路径，“通蹊”表达也不够自然，组合近于路径词语的重复堆叠。"
    },
    {
      "name": "玉烛",
      "decision": "keep",
      "reason": "有古典词义，可指祥和清明的时世或烛光意象；两字简洁，语义可核，不因词语古雅而否决。"
    },
    {
      "name": "花烛",
      "decision": "keep",
      "reason": "是自然完整的常见词，兼有花饰烛光及婚庆语境联想，简洁易记，适合作为待复核品牌名。"
    },
    {
      "name": "烛影间",
      "decision": "uncertain",
      "reason": "可理解为烛影之间或有烛影的空间，但“间”的关系不够明确，完整组合自然度和所指存疑。"
    },
    {
      "name": "烛光如昼",
      "decision": "reject",
      "reason": "完整组合是“烛光明亮如白昼”的描写性判断句，偏修辞句而非凝练品牌名。"
    },
    {
      "name": "烛林",
      "decision": "uncertain",
      "reason": "可想象烛光如林或林间烛火，但两字间的具体关系未明，语义联结略显生硬。"
    },
    {
      "name": "烛云",
      "decision": "uncertain",
      "reason": "可解作烛光映云或烛烟如云，但两字组合的关系不明确，依赖补充想象才能成立。"
    },
    {
      "name": "烛风",
      "decision": "uncertain",
      "reason": "可联想到烛火受风或烛旁清风，但两字直接组合缺少稳定、自然的语义关系。"
    },
    {
      "name": "王冠",
      "decision": "reject",
      "reason": "完整词语直接指帝王的帽子或冠冕，是具体物品通称，名称本身缺少品牌化转义。"
    },
    {
      "name": "王庭",
      "decision": "uncertain",
      "reason": "完整词语有朝廷等明确义项，但品牌使用容易直接落入王权、宫廷语境，未呈现独立而清楚的品牌意象。"
    },
    {
      "name": "王城",
      "decision": "uncertain",
      "reason": "完整词语就是都城、京城，指向明确但偏地理类别称谓，作为品牌名缺乏进一步辨识度。"
    },
    {
