    "dictionary_phrase_entries": {
      "人和": [
        {
          "title": "人和",
          "pinyin": "rén hé",
          "definition": "人與人之間團結，感情融洽。《孟子．公孫丑下》：「孟子曰：『天時不如地利，地利不如人和。』」《三國演義》第三八回：「將軍欲成霸業，北讓曹操占天時，南讓孫權占地利，將軍可占人和。」",
          "entry_id": "092140168",
          "sheet": "1150929辭典匯出",
          "row": 133887,
          "source_url": "https://language.moe.gov.tw/001/Upload/Files/site_content/M0001/respub/download/dict_revised_2015_20260929.zip",
          "source_sha256": "65a24fff76d0fbfa078541f39761bb9f302bdf7ad6bb48be4ce1052d1b49f609"
        }
      ],
      "人文": [
        {
          "title": "人文",
          "pinyin": "rén wén",
          "definition": "1.人類的禮樂教化。《易經．賁卦．彖曰》：「觀乎天文以察時變，觀乎人文以化成天下。」唐．孔穎達．正義：「人文，則詩書禮樂之謂。」\n2.人事。《後漢書．卷七三．劉虞等傳．論曰》：「舍諸天運，徵乎人文，則古之休烈，何遠之有！」\n3.泛指人類社會的各種文化現象。",
          "entry_id": "092140471",
          "sheet": "1150929辭典匯出",
          "row": 134153,
          "source_url": "https://language.moe.gov.tw/001/Upload/Files/site_content/M0001/respub/download/dict_revised_2015_20260929.zip",
          "source_sha256": "65a24fff76d0fbfa078541f39761bb9f302bdf7ad6bb48be4ce1052d1b49f609"
        }
      ],
      "人望": [
        {
          "title": "人望",
          "pinyin": "rén wàng",
          "definition": "眾人所屬望。《後漢書．卷一二．王昌傳》：「郎以百姓思漢，既多言翟義不死，故詐稱之，以從人望。」《三國演義》第四回：「李儒勸卓擢用名流，以收人望，因薦蔡邕之才。」",
          "entry_id": "092140482",
