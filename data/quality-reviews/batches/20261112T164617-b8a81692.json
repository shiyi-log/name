  "reviews": [
    {
      "name": "溪螈",
      "decision": "keep",
      "reason": "“溪螈”可自然理解为溪流中的螈类，物象明确且简洁，有一定辨识度；虽非固定词语，但组合通顺。与暂留候选“蝾螈”都涉及螈类，但前者以溪流构成具体意象，并非仅替换近义字的重复组合。"
    },
    {
      "name": "山螈",
      "decision": "keep",
      "reason": "可理解为山地中的螈类，构词简洁、语义可辨，没有明显字义错误或生硬拼接；与“溪螈”共享“螈”字，但意象分别为山地与溪流，并非同一组合的换序或近义替换。"
    },
    {
      "name": "听芦风",
      "decision": "keep",
      "reason": "可理解为聆听芦苇间的风声，画面与语义关系自然，具有简洁的诗性辨识度；不等同于完整判断句或口号。虽与暂留的多项“听风”名称共享听风意象，但“听芦风”以芦苇限定风声，构成较具体的不同意象，不是仅替换近义配字的近似变体。"
    },
    {
      "name": "荇塘",
      "decision": "keep",
      "reason": "“荇”指水生植物，“塘”指池塘，组合自然地指向生有荇类植物的塘景，语义清楚、凝练；未见仅凭字形或同音借义的问题。"
    }
  ]
}
