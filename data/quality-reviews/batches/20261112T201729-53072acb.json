  "reviews": [
    {
      "name": "琭润",
      "decision": "keep",
      "reason": "“琭”可指玉，“润”有温润之义，组合可自然理解为温润如玉，简洁凝练且具有品牌辨识度；与暂留候选“琭光”“琭华”共享锚字，但意象关系不同，不构成近似重复。"
    },
    {
      "name": "栌林",
      "decision": "uncertain",
      "reason": "“栌”可指支承构件或漆树，接“林”虽可作字面组合，但两字间关系不够明确，整体自然度与品牌指向存疑。"
    },
    {
      "name": "栌庭春晓",
      "decision": "keep",
      "reason": "可理解为栌木庭院中的春日拂晓，画面完整、语序自然，具有清晰的景物意象；与暂留候选“楸庭春晓”“柰林春晓”均不只是同义替换，意象关系有别。"
    },
    {
      "name": "栌边远帆",
      "decision": "keep",
      "reason": "可理解为栌木旁望见远处的帆影，景物关系自然，构成凝练的画面感名称；与暂留候选中含“远帆”的名称在意象与关系上并不相同。"
    },
    {
      "name": "栌海同春",
      "decision": "uncertain",
      "reason": "“海”与“同春”可勉强读作海天共迎春意，但“栌海”关系不明，整体语义连接牵强，名称自然度存疑。"
    },
    {
      "name": "栌风过野",
      "decision": "reject",
      "reason": "结构近似“风过野”的景物句式，整体更像写景短句而非凝练品牌名；且与暂留候选“桉风过野”只替换开头单字，属于近似变体。"
    }
  ]
