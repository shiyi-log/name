  "reviews": [
    {
      "name": "案牍",
      "decision": "keep",
      "reason": "指公文、文书，词义明确且构词自然；虽带有文书事务的传统意味，整体简洁，可作为品牌名继续复核。"
    },
    {
      "name": "烽堠",
      "decision": "keep",
      "reason": "“烽”指边防警报烟火，“堠”指瞭望敌情的碉堡或里程土台，组合构成古代边防意象，语义连贯且有辨识度。"
    },
    {
      "name": "山堠",
      "decision": "keep",
      "reason": "指山中的堠台或沿途里程标记，古诗用例也符合此义；物象明确、组合自然，可作为品牌名继续复核。"
    },
    {
      "name": "星堠",
      "decision": "keep",
      "reason": "可理解为星下或如星点般的古代堠台，意象简洁，虽非固定词语，组合仍自然且有辨识度。"
    },
    {
      "name": "云间堠",
      "decision": "keep",
      "reason": "“云间”修饰堠台，形成云间山路驿堠的景象；语法通顺、意象完整，不依赖无依据的专名解释。"
    },
    {
      "name": "堠台",
      "decision": "keep",
      "reason": "指瞭望或标记里程的土台，意义明确，构词自然；虽偏古典物象，仍具简洁的品牌名形式。"
    },
    {
      "name": "堠标",
      "decision": "keep",
      "reason": "可理解为堠台所作的道路或边防标记，语义关系清楚，简洁而有辨识度。"
    },
    {
      "name": "堠灯",
      "decision": "keep",
      "reason": "可理解为堠台上的灯火或驿路堠灯，物象关系自然，简洁且具画面感。"
    },
    {
      "name": "关堠",
      "decision": "keep",
      "reason": "指关隘附近的堠台，两个字的空间关系明确，组合凝练，不是通用产品类别词。"
    },
    {
      "name": "堠边风",
      "decision": "keep",
      "reason": "形成堠台边的风这一完整自然景象，语法通顺、意象清楚；与暂留名称“砚边风”虽同为“某物边风”结构，但所指意象与关系不同，不构成近似重复。"
    },
    {
      "name": "暮堠",
      "decision": "keep",
      "reason": "可理解为暮色中的堠台或傍晚行经的堠，时间与物象关系自然，组合凝练且有辨识度。"
    }
  ]
