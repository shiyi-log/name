            "sheet": "1150929辭典匯出",
            "row": 10212,
            "source_url": "https://language.moe.gov.tw/001/Upload/Files/site_content/M0001/respub/download/dict_revised_2015_20260929.zip",
            "source_sha256": "65a24fff76d0fbfa078541f39761bb9f302bdf7ad6bb48be4ce1052d1b49f609",
            "authority": "Ministry of Education Revised Mandarin Chinese Dictionary",
            "cross_references": [
              {
                "title": "木公",
                "pinyin": "mù gōng",
                "definition": "1.松科「松樹」的別名。參見「松樹」條。\n2.神話傳說中的仙人東華帝君。參見「東王公」條。",
                "entry_id": "015050081",
                "sheet": "1150929辭典匯出",
                "row": 32536
              },
              {
                "title": "松樹",
                "pinyin": "sōng shù",
                "definition": "泛指裸子植物松科松屬之樹種。常綠喬木。枝條輪生、對生或互生。針葉常成束著生。毬花雌雄同株。毬果木質，各果鱗具種子二枚。木材用途甚廣，種子可食用、榨油，松脂可提煉松香、松節油。也稱為「木公」、「貞木」。",
                "entry_id": "101980083",
                "sheet": "1150929辭典匯出",
                "row": 144196
              }
            ]
          }
