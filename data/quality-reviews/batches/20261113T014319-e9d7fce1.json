  "reviews": [
    {
      "name": "山浪间",
      "decision": "uncertain",
      "reason": "可理解为山与浪之间的空间，但“浪间”搭配不够自然，完整组合的语义关系含混；与暂留名“山间邨”共享“山间”结构但意象不同，不构成近似重复。"
    },
    {
      "name": "浪映星河",
      "decision": "keep",
      "reason": "可自然理解为波浪映照星河，画面清晰、组合凝练，有辨识度；与暂留的“映星河”类名称虽共享意象，但主语“浪”与其配字不同，不是仅换近义字的变体。"
    },
    {
      "name": "月照沧浪",
      "decision": "keep",
      "reason": "“沧浪”可指青色的水，整体可解作月光照在苍青水面，语义通顺且有古典物象感；与暂留名“月照桹影”等虽同用“月照”结构，但实际意象与关系不同。"
    },
    {
      "name": "云开见浪",
      "decision": "keep",
      "reason": "可自然理解为云层散开后看见水浪，语义清楚，具有画面感和凝练度；与暂留的“云开见”类名称是同一表达框架，但“浪”与其目标意象并非近义替换，整体意象不同。"
    },
    {
      "name": "羁鸟归林",
      "decision": "reject",
      "reason": "完整名称是完整陈述句，表达受羁之鸟回归树林，语义自然但更像文学化叙述或意象句，缺少品牌名所需的凝练感；也与暂留名“椋鸟归林”构成同一鸟归树林意象，仅以鸟的具体种类替换。"
    },
    {
      "name": "楂林",
      "decision": "uncertain",
      "reason": "“楂”可读chá，指木筏或树桩；也可读zhā，见于“山楂”。与“林”组合后究竟指树桩之林、山楂林还是其他含义不明确，读音和语义关系均缺乏足够依据。"
    }
  ]
