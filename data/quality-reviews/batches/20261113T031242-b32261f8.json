  "reviews": [
    {
      "name": "炊烟",
      "decision": "keep",
      "reason": "常见自然意象，指人家炊煮升起的烟，画面清楚、语义自然，作为品牌名凝练且有辨识度。"
    },
    {
      "name": "炊禾",
      "decision": "reject",
      "reason": "“炊”指烧火煮食，“禾”指谷类植物，组合关系不自然，像把烹饪动作与原料机械并置。"
    },
    {
      "name": "炊雨",
      "decision": "reject",
      "reason": "“炊”与“雨”直接并置缺乏清晰语义关系，作为完整名称显得生硬，需牵强补充意象才能解释。"
    },
    {
      "name": "蔓桥",
      "decision": "uncertain",
      "reason": "字义可理解为藤蔓与桥，但两者组合的关系和整体意象不够明确，名称自然度存疑。"
    },
    {
      "name": "枝繁蔓茂",
      "decision": "reject",
      "reason": "由“枝繁”“蔓茂”组成的固定式繁盛描写，完整表达近似成句，且与常见成语“枝繁叶茂”高度相似，不具备凝练的品牌名感。"
    },
    {
      "name": "蔓华",
      "decision": "uncertain",
      "reason": "可理解为藤蔓繁盛或藤蔓之花，但组合义不稳定；文献中的“蔓华”亦有特定词义，难以据此确认此处的自然语义和品牌辨识度。"
    },
    {
      "name": "蔓萝",
      "decision": "reject",
      "reason": "“蔓”与“萝”都指蔓生植物，语义重复叠加，作为名称缺少明确的组合关系与辨识度。"
    }
  ]
