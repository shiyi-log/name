  "reviews": [
    {
      "name": "琤悦",
      "decision": "keep",
      "reason": "“琤”指玉器相击的清越声，“悦”表喜悦，组合可理解为悦耳清亮之声或令人愉悦，语义自然且凝练；诗句用例也印证“琤悦”可作连续表达。虽与“琤琮”共享琤字，但意象和构词关系不同，不构成重复。"
    },
    {
      "name": "琤玥",
      "decision": "keep",
      "reason": "“琤”是玉声，“玥”是传说中的神珠，组合形成玉声与珍宝的联想，语义清楚且有品牌辨识度。与“琤悦”仅共享锚字，意象关系不同，不属于近似重复。"
    },
    {
      "name": "松风琤响",
      "decision": "reject",
      "reason": "整体更像对松风发出玉石般声响的景物描述，四字组合偏句式化、描写性强，品牌名凝练度不足；且与已暂留的“松风玱佩”同属松风与玉器声响的近似意象组合。"
    },
    {
      "name": "佩琤",
      "decision": "uncertain",
      "reason": "“佩”可指佩戴或玉佩，“琤”指玉声；若理解为佩玉相击之声，联想可成立，但两字直接组合的关系不够自然，容易显得省略或生造。与“佩璆”等候选虽共享佩字，但并非仅换近义配字，故不据此判重复。"
    }
  ]
