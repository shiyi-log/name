  "reviews": [
    {
      "name": "鸫鸣",
      "decision": "keep",
      "reason": "意为鸫鸟鸣叫，构词自然、意象明确，简洁有辨识度；与暂保留的“鹳鸣”等共享“鸣”字，但鸟类意象不同，不构成近似重复。"
    },
    {
      "name": "鸫栖林",
      "decision": "keep",
      "reason": "可自然理解为鸫鸟栖息于林，语义连贯，有具体自然意象；虽与“鹳栖林”同构，但主旨鸟类不同，不是仅换近义配字的重复组合。"
    },
    {
      "name": "林间听鸫",
      "decision": "keep",
      "reason": "可理解为在林间聆听鸫鸟，虽是较完整的场景表达，但并非判断句或口号，语序自然且画面清晰；与已有“林间听莺”“山间听莺”等仅共享听鸟结构，鸟类及场景意象并非近义替换。"
    },
    {
      "name": "鸫翼",
      "decision": "keep",
      "reason": "意为鸫鸟之翼，组合简洁且语义明确，具有自然物象辨识度；与已有翼字候选没有实际相同的物象关系。"
    },
    {
      "name": "山鸫",
      "decision": "uncertain",
      "reason": "可理解为山地鸫鸟，但“山鸫”也容易被理解为鸟类名称或分类称呼，作为品牌名的专名辨识度不足；与“山鸟哢”等仅共享山字，不构成重复。"
    },
    {
      "name": "鸫归林",
      "decision": "keep",
      "reason": "意为鸫鸟归返林中，语义顺畅、意象完整；与“鹀归林”“椋鸟归林”等同有归林结构，但主语鸟类和整体意象不同，不是单纯换近义字的变体。"
    },
    {
      "name": "鸫过溪",
      "decision": "keep",
      "reason": "呈现鸫鸟经过溪边的自然场景，语义可解且表达凝练；与已有“蛱过溪”“麈过溪”等共享动作和地点结构，但动物意象不同，不构成近似重复。"
    },
    {
      "name": "鸫临远岫",
      "decision": "keep",
      "reason": "可理解为鸫鸟临近远处山峰，意象清楚，虽较书面但语序可通；与“鸧临远岫”“鹒鸣远岫”等存在相近的远岫构景，但并非仅替换同义字，鸟类与关系表达不同。"
    }
  ]
