  "reviews": [
    {
      "name": "鹜栖",
      "decision": "keep",
      "reason": "“鹜”指野鸭，“栖”有停留、歇息义，组合成野鸭栖息的简洁自然意象，语义可核且具有辨识度；与暂留候选“鹜栖洲”相比，并非仅替换近义配字的重复组合。"
    },
    {
      "name": "鹜归汀",
      "decision": "keep",
      "reason": "可自然理解为野鸭归落水边沙洲，字义衔接通顺，形成具体而凝练的水岸物象；与暂留候选中含“鹜”或“汀”的名称没有相同意象与关系的近似组合。"
    },
    {
      "name": "东礵岛",
      "decision": "keep",
      "reason": "“礵”可指福建的岛名，“东礵岛”整体是自然的地名式组合，语义明确、简洁，有专名辨识度；不依赖未知行业或地域背景解释。"
    },
    {
      "name": "礵岛远望",
      "decision": "keep",
      "reason": "以礵岛为观望对象，“远望”构成自然动作表达，整体像凝练的景象题名而非完整判断句；与暂留的远望类名称没有相同对象与关系的近似组合。"
    },
    {
      "name": "云礵",
      "decision": "keep",
      "reason": "“云”与岛名用字“礵”组合简短自然，可形成云与岛的景象联想；并非借“礵”的部件或读音释义，具有一定品牌辨识度。"
    },
    {
      "name": "礵海听风",
      "decision": "keep",
      "reason": "以礵岛海岸为景，听风的动作关系自然，组合简洁且有清晰物象；与暂留的海边听风名称相比，核心对象与意象关系并不相同，未构成仅换字的近似变体。"
    },
    {
      "name": "礵屿",
      "decision": "keep",
      "reason": "可理解为礵岛或带有礵意象的岛屿，组合简洁、语义连贯，有专名式辨识度；与暂留的“海屿”“江屿”等仅共享岛屿意象，未形成相同专名关系的近似组合。"
    }
  ]
