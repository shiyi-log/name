  "reviews": [
    {
      "name": "鸟啭",
      "decision": "keep",
      "reason": "意为鸟鸣婉转，字义直白且组合自然简洁；有古诗连续用例，具有清晰的自然意象和品牌辨识度。"
    },
    {
      "name": "啼啭",
      "decision": "keep",
      "reason": "“啼”指鸟兽鸣叫，“啭”指婉转鸣唱，构词自然，表达鸟鸣婉转；有古诗用例，整体凝练。"
    },
    {
      "name": "山鸟啭",
      "decision": "keep",
      "reason": "意为山中鸟鸣婉转，语义明确自然，古诗中有连续用例；不是完整判断句，具备简洁的意象感。"
    },
    {
      "name": "林鸟啭歌",
      "decision": "reject",
      "reason": "“啭歌”搭配生硬，鸟鸣、歌唱两层表达叠加，整体像对景物的描述而非凝练名称。"
    },
    {
      "name": "群鸟啭林",
      "decision": "reject",
      "reason": "将群鸟鸣唱与树林拼接成景物句式，语序和关系生硬，完整名称缺少凝练的品牌感。"
    },
    {
      "name": "山林鸟啭",
      "decision": "keep",
      "reason": "意为山林间鸟鸣婉转，语序自然，画面清楚而凝练；虽与“山鸟啭”共享意象，但增加“林”形成山林环境，不是仅换近义字的重复组合。"
    },
    {
      "name": "云山啭",
      "decision": "uncertain",
      "reason": "“云山”与“啭”的语义关系不清，难以确认是鸟鸣意象的省略表达还是机械拼接，自然度存疑。"
    },
    {
      "name": "风过松啭",
      "decision": "reject",
      "reason": "“风过松”与“啭”关系不明，容易造成风过松林而发出鸟鸣的生硬拼接；且与暂留候选“风过松岚”结构近似，仅替换末字构成近似变体。"
    }
  ]
