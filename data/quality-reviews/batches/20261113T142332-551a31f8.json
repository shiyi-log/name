  "reviews": [
    {
      "name": "铙音",
      "decision": "keep",
      "reason": "“铙”指乐器，“音”指声音，组合可理解为铙声，语义明确凝练，有器乐品牌辨识度。"
    },
    {
      "name": "铙鸣",
      "decision": "keep",
      "reason": "可理解为铙发声或铙声鸣响，搭配自然，形成鲜明的听觉意象；与“铙音”意象接近，属于同批近似组合，建议二者择一保留。"
    },
    {
      "name": "铙韵",
      "decision": "keep",
      "reason": "以铙为核心、以韵指其声韵，构词自然且有音乐意象；与“铙音”“铙鸣”主题相近，建议同组择一。"
    },
    {
      "name": "铙乐",
      "decision": "keep",
      "reason": "可解作铙乐或铙所奏之乐，语义通顺简洁；虽与其他铙字候选共享乐器意象，但组合关系明确。"
    },
    {
      "name": "鲡跃",
      "decision": "keep",
      "reason": "“鲡”指鳗鲡，“跃”指跳跃，构成水中鱼类跃动的鲜明物象，简洁自然；与已暂留的“鲮跃”“鲳跃”“鲵跃”均为鱼名加“跃”的同构近似候选，建议该组择一。"
    },
    {
      "name": "鲡渊",
      "decision": "keep",
      "reason": "可理解为鳗鲡与深渊水域相联系，物象清楚，搭配不生硬；与“鳄渊”“鳤渊”等已有候选构成鱼类名加“渊”的近似组合，建议择一。"
    },
    {
      "name": "鲡澜",
      "decision": "keep",
      "reason": "可形成鳗鲡游于波澜间的水域意象，搭配自然，有画面感；与“鲡渊”共享水中鳗鲡意象但关系不同，不构成仅换近义字的重复。"
    },
    {
      "name": "江鲡",
      "decision": "keep",
      "reason": "可指江中鳗鲡，名词组合自然、简洁，作为品牌名有具体物象；与同批其他鲡字候选不属于仅换近义字的重复。"
    },
    {
      "name": "鲡动",
      "decision": "reject",
      "reason": "“鲡动”缺少自然的词法关系，像把鱼名与泛指动作字直接拼接，语义和品牌意象均不清楚。"
    },
    {
      "name": "春江游鲡",
      "decision": "keep",
      "reason": "可理解为春日江中游动的鳗鲡，画面完整，语序自然；与已暂留的“春水鲦游”等共享春江水生物意象，但核心物种和构词关系不同，并非简单近义替换。"
    },
    {
      "name": "远浦归鲡",
      "decision": "keep",
      "reason": "“远浦”指远处水滨，“归鲡”可理解为鳗鲡归向水岸或栖处，形成完整的水景意象，语义虽偏诗性但不生硬；与“远浦归燕”有相同的“远浦＋归＋动物”结构，但动物及意象不同，不属于仅换近义配字的重复。"
    }
  ]
