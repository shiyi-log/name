  "reviews": [
    {
      "name": "岘阳",
      "decision": "keep",
      "reason": "“岘”指山，“阳”可指山南或向阳处，组合可理解为山阳、向阳之地；有诗文中“岘阳”用例，凝练自然。"
    },
    {
      "name": "云岘山",
      "decision": "keep",
      "reason": "可理解为云绕岘山的自然意象，构词顺畅，具备山水品牌名的凝练感；未见与暂留候选构成仅换近义字的重复。"
    },
    {
      "name": "岘野",
      "decision": "keep",
      "reason": "“岘”与“野”组合成山野地景，简洁通顺；意象清楚，不依赖未经证实的专名解释。"
    },
    {
      "name": "岘光",
      "decision": "keep",
      "reason": "可理解为岘山之光或山间光景，语义自然、简短，有品牌辨识度，且与暂留的“光”字候选并非同一意象关系的近似替换。"
    },
    {
      "name": "岘谷",
      "decision": "keep",
      "reason": "以山名义的“岘”与山间低地义的“谷”组成具体地景，语义清楚、自然凝练。"
    },
    {
      "name": "岘峰见远",
      "decision": "reject",
      "reason": "“见远”可理解为望见远处，但全名形成描述性句式，读来更像景物题句而非凝练品牌名；且与暂留候选“绀山见远”共享“见远”结构及远望意象，近似度较高。"
    },
    {
      "name": "铬钢",
      "decision": "reject",
      "reason": "这是铬与钢构成的材料通称，完整名称直接等同于通用材料类别，缺少品牌名所需的区分性。"
    },
    {
      "name": "铬铁",
      "decision": "reject",
      "reason": "名称直接指向铬铁这一材料或合金类别，属于通用材料名称，不宜作为具有辨识度的品牌名。"
    },
