  "reviews": [
    {
      "name": "闰余",
      "decision": "keep",
      "reason": "“闰余”有历法语义，指岁时推算中积余而置闰的余分，所给诗例也处于岁时语境。整词凝练，具有时间积余的鲜明意象，非机械叠加；与“余裕”“余庆”等已有名称的语义关系不同。"
    },
    {
      "name": "丹忱",
      "decision": "reject",
      "reason": "整词确指赤诚的心，字义及构词均成立。但与已保留的“丹悃”表达相同的赤诚心意，“忱”“悃”属于近义配字替换，按跨批近似组合规则不再保留。"
    },
    {
      "name": "词章",
      "decision": "reject",
      "reason": "“词章”是自然成立的词，指诗文、文章，所给用例支持这一含义。但与已保留的“篇章”在泛指成篇文字这一核心意象上高度重合，属于更换近义配字的近似组合，不再重复保留。"
    },
    {
      "name": "译笔",
      "decision": "keep",
      "reason": "“译笔”可指翻译的文笔、笔法，完整词义清楚，组合自然凝练，具备品牌辨识度，并不直接等同于翻译服务类别。与“文笔”“笔耕”等名称相比，翻译表达这一限定形成了明确的语义区别。"
    }
  ]
}
